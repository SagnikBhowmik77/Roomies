# Single-container deploy: builds the React app, then serves the API,
# the websockets and the SPA from one daphne process. Used by Render;
# local development still uses docker-compose.yml and its own Dockerfile.

FROM node:22-alpine AS frontend
WORKDIR /fe
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.14-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_DEBUG=0

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
COPY --from=frontend /fe/dist ./frontend/dist

# Collect Django's admin assets and the React build into one static root.
RUN DJANGO_SECRET_KEY=build-time-only python manage.py collectstatic --noinput

# Free instances have an ephemeral filesystem, so the demo database is
# rebuilt and reseeded on every boot. seed_demo is idempotent either way.
CMD ["sh", "-c", "python manage.py migrate --noinput && python manage.py seed_demo && daphne -b 0.0.0.0 -p ${PORT:-8000} config.asgi:application"]

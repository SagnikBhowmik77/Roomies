# Copy to .env and adjust. Nothing here is a real secret.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (docker-compose sets POSTGRES_HOST=db for you; leave unset to
# fall back to SQLite for quick local hacking)
POSTGRES_DB=roomies
POSTGRES_USER=roomies
POSTGRES_PASSWORD=roomies
#POSTGRES_HOST=localhost
#POSTGRES_PORT=5432

# Redis (leave unset to fall back to local-memory cache + eager Celery)
#REDIS_URL=redis://localhost:6379/0

# Dev OTP: the fixed login code while OTP_DEV_MODE is on (default in DEBUG).
# In production, wire an SMS provider and set OTP_DEV_MODE=0.
DEV_OTP_CODE=123456
